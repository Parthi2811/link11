# ─── LinkedIn Credentials ─────────────────────────────────────────────────────
LINKEDIN_EMAIL=your_email@gmail.com
LINKEDIN_PASSWORD=your_password_here

# ─── LLM API Keys ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=sk-...        # Optional: if using GPT-4o

# ─── Job Search Config ────────────────────────────────────────────────────────
JOB_KEYWORDS=AI Automation
JOB_LOCATION=Remote
MAX_JOBS_PER_RUN=30
POSTED_WITHIN_HOURS=24

# ─── Application Mode ─────────────────────────────────────────────────────────
# Set to "true" to pause and ask before final submission
HUMAN_IN_THE_LOOP=true
# Set to "true" to scrape+tailor but NEVER submit
DRY_RUN=false

# ─── Paths ────────────────────────────────────────────────────────────────────
BASE_RESUME_PATH=data/base_resume.pdf
SESSION_PATH=data/session.json
DB_PATH=data/jobs.db
TAILORED_DIR=data/tailored
